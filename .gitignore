# Snakemake and Conda runtime state
.snakemake/

# Workflow-generated output roots
psap/
results/
logs/
benchmarks/

# User-owned run bindings
runs/*.yaml
!runs/*.example.yaml

# Smoke-test work directories
smoke-work/
smoke-output/

# Language caches and interactive session state
__pycache__/
*.py[cod]
*.swp
.Rhistory
.RData
.Ruserdata

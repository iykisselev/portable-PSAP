# Snakemake and Conda runtime state
.snakemake/

# Workflow-generated output roots
psap/
results/
logs/
benchmarks/

# User-owned run bindings; keep portable templates under version control.
runs/*.yaml
!runs/*.example.yaml

# Smoke-test work directories (fixtures remain trackable)
smoke-work/
smoke-output/

# Language caches and interactive session state
__pycache__/
*.py[cod]
.Rhistory
.RData
.Ruserdata

from pathlib import Path
import sys

from snakemake.utils import validate
from snakemake.utils import min_version

WORKFLOW_PYTHON_DIR = Path(workflow.basedir) / "lib" / "python"
sys.path.insert(0, str(WORKFLOW_PYTHON_DIR))
from workflow_plan import build_workflow_plan, normalize_run_config

min_version("8.0")

# The versioned scientific defaults live in config/config.yaml. Each run adds
# its site-specific paths and settings through --configfile.
configfile: str(Path(workflow.basedir).parent / "config" / "config.yaml")

# Older run manifests did not name a workflow mode. Normalize a copy so they
# still work, while leaving Snakemake's original configuration untouched.
RUN_CONFIG = normalize_run_config(config)

validate(
    RUN_CONFIG,
    Path(workflow.basedir) / "schemas" / "config.schema.yaml",
)

WORKFLOW_PLAN = build_workflow_plan(RUN_CONFIG)
WORKFLOW_MODE = WORKFLOW_PLAN.mode

# All modes use the same deployment settings, so load them once before choosing
# the mode-specific rules below.
include: "rules/deployment.smk"
include: "rules/execution_resources.smk"

if WORKFLOW_MODE in {"generate", "full"}:
    include: "rules/generate/context.smk"
    include: "rules/generate/prepare.smk"
    include: "rules/generate/calculate.smk"
    include: "rules/generate/finalize.smk"

if WORKFLOW_MODE == "generate":
    # Public generate-mode target. Result aliases are intentionally unsupported.
    rule null_distributions:
        input:
            marker=rules.validate_null_distribution_bundle.output.marker,
            allele_states=lambda wc: generation_partition_artifacts(
                wc, "allele_states"
            ),
            allele_memberships=lambda wc: generation_partition_artifacts(
                wc, "allele_membership"
            ),
            allele_scores=lambda wc: generation_partition_artifacts(
                wc, "allele_scores"
            ),
            statistics=generation_statistics_artifacts,
            lookup_het=lambda wc: generation_bucket_artifacts(wc, "lookup_het"),
            lookup_hom=lambda wc: generation_bucket_artifacts(wc, "lookup_hom"),
            lookup_hem=(
                lambda wc: generation_bucket_artifacts(wc, "lookup_hem")
                if GENERATION_HEM_ENABLED
                else []
            ),
            diagnostics=lambda wc: generation_bucket_artifacts(wc, "diagnostics")
        default_target: True

elif WORKFLOW_MODE in {"apply", "full"}:
    include: "rules/apply/paths.smk"
    include: "rules/apply/lookup_inputs.smk"
    include: "rules/apply/sample_discovery.smk"
    include: "rules/apply/resources.smk"
    include: "rules/apply/validation_helpers.smk"

    # These checks read small reports and finish quickly, so running them locally
    # avoids scheduler overhead. Compute-heavy jobs still go to the scheduler.
    localrules: validate_cohort, validate_resources, validate_model, merge_validation, require_valid_inputs, summarize_annotations, require_valid_annotations

    include: "rules/apply/validate.smk"
    include: "rules/apply/prepare.smk"
    include: "rules/apply/variants.smk"
    include: "rules/apply/annotation.smk"
    include: "rules/apply/samples.smk"
    include: "rules/apply/scoring.smk"
    include: "rules/apply/cohort.smk"

    if WORKFLOW_MODE == "apply":
        rule all:
            input:
                str(COHORT_DIR / "cohort_candidates.tsv.gz"),
                str(COHORT_DIR / "cohort_summary.tsv.gz"),
                str(COHORT_DIR / "control_variants.tsv.gz")
            default_target: True
    else:
        rule full_results:
            input:
                marker=rules.validate_null_distribution_bundle.output.marker,
                cohort_candidates=str(COHORT_DIR / "cohort_candidates.tsv.gz"),
                cohort_summary=str(COHORT_DIR / "cohort_summary.tsv.gz"),
                control_variants=str(COHORT_DIR / "control_variants.tsv.gz"),
                allele_states=lambda wc: generation_partition_artifacts(
                    wc, "allele_states"
                ),
                allele_memberships=lambda wc: generation_partition_artifacts(
                    wc, "allele_membership"
                ),
                allele_scores=lambda wc: generation_partition_artifacts(
                    wc, "allele_scores"
                ),
                statistics=generation_statistics_artifacts,
                lookup_het=lambda wc: generation_bucket_artifacts(
                    wc, "lookup_het"
                ),
                lookup_hom=lambda wc: generation_bucket_artifacts(
                    wc, "lookup_hom"
                ),
                lookup_hem=(
                    lambda wc: generation_bucket_artifacts(wc, "lookup_hem")
                    if GENERATION_HEM_ENABLED
                    else []
                ),
                diagnostics=lambda wc: generation_bucket_artifacts(
                    wc, "diagnostics"
                )
            default_target: True

else:
    raise ValueError(f"Unsupported workflow mode: {WORKFLOW_MODE!r}")
